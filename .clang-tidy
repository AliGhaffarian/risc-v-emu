# .clang-tidy in project root
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  performance-*,
  readability-*,
  -llvmlibc-*

WarningsAsErrors: >
  clang-analyzer-unix.MallocSizeof

# Only analyze headers in src/ and tests/ (skips _deps/unity_download)
HeaderFilterRegex: '(src|tests)/.*'
